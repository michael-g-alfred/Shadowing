      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم خصم رسوم بنسبة 10%% من المبلغ المعروض (%1$@). ستستلم فعليًا %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
